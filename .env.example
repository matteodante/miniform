# Copy this file to .env. Miniform loads .env from its working directory.
# Variables already present in the process environment take precedence.

# Runtime
MINIFORM_ENV=development
MINIFORM_PORT=8080
# debug, info, warn, warning, or error
MINIFORM_LOG_LEVEL=info

# Set a stable random value in production: openssl rand -hex 32
# MINIFORM_SESSION_SECRET=replace-with-a-secret-manager-value
# MINIFORM_SESSION_TIMEOUT_SECONDS=604800

# Storage
MINIFORM_DATA_DIR=./storage
# Filename only; set MINIFORM_DATABASE_PATH for an explicit path.
MINIFORM_DATABASE_FILENAME=miniform.db
# MINIFORM_DATABASE_PATH=/absolute/path/to/miniform.development.db
# MINIFORM_LOGS_DIR=./storage/logs

# Submission, storage, and concurrency limits
# MINIFORM_MAX_INPUT_FIELDS=200
# MINIFORM_MAX_PAYLOAD_BYTES=65536
# MINIFORM_MAX_UPLOAD_STORAGE_BYTES=1073741824
# MINIFORM_REQUEST_CONCURRENCY=32
# MINIFORM_PUBLIC_GLOBAL_RATE_LIMIT=120
# MINIFORM_WEBHOOK_SIGNATURE_HEADER=X-Miniform-Signature
# MINIFORM_WEBHOOK_RETRY_LIMIT=3
# MINIFORM_WEBHOOK_BACKOFF_SCHEDULE=1,5,15,60
