# ============================================================================
# REQUIRED SECURITY SETTINGS
# ============================================================================
# HMAC secret for signing session cookies (REQUIRED in production)
# Generate with: openssl rand -hex 32
# ⚠️  If not set, a random secret is generated on each startup, invalidating sessions
MINIFORM_SESSION_SECRET=replace-me-with-random-secret

# Salt for hashing IP addresses before storage (REQUIRED for privacy)
# Generate with: openssl rand -hex 32  
# ⚠️  If not set, a random salt is generated on each startup, changing all IP hashes
MINIFORM_ANON_SALT=replace-me-with-random-salt

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
# Environment: development (default), production
# Set MINIFORM_ENV=production for live deploys. Production marks the
# session cookie Secure, so Miniform MUST be served over HTTPS
# (terminate TLS with Caddy/Nginx/etc.) — otherwise browsers silently
# drop the cookie and login appears to fail.
# MINIFORM_ENV=production

# HTTP port
MINIFORM_PORT=8080

# Log level: debug, info, warn, error
MINIFORM_LOG_LEVEL=info

# ============================================================================
# DATA STORAGE
# ============================================================================
# Directory for database and logs (will be created if it doesn't exist)
MINIFORM_DATA_DIR=./storage

# SQLite database filename
MINIFORM_DATABASE_FILENAME=miniform.db

# Optional explicit database path. When set, it overrides DATA_DIR and filename.
# MINIFORM_DATABASE_PATH=/app/storage/miniform.production.db

# Optional logs directory and session lifetime.
# MINIFORM_LOGS_DIR=/app/logs
# MINIFORM_SESSION_TIMEOUT_SECONDS=86400

# Form and webhook limits.
# MINIFORM_MAX_INPUT_FIELDS=200
# MINIFORM_WEBHOOK_SIGNATURE_HEADER=X-Miniform-Signature
# MINIFORM_WEBHOOK_RETRY_LIMIT=3
# MINIFORM_WEBHOOK_BACKOFF_SCHEDULE=1,5,15,60

# ============================================================================
# INITIAL ADMIN USER (Auto-created on first run)
# ============================================================================
# Email: admin@miniform.local
# Password: a unique temporary value printed once in application logs
# Change the email and password immediately after signing in.

# ============================================================================
# DATABASE-BACKED SETTINGS (Configure via Admin UI or CLI)
# ============================================================================
# The following are configured through the dashboard or miniform CLI, NOT environment variables:
#
# Mailer Profiles: /admin/settings/mailers
#   - Configure Mailgun credentials per profile
#   - Assign profiles to forms for email forwarding
#
# Captcha Profiles: /admin/settings/captcha
#   - Configure Cloudflare Turnstile per profile
#   - Multi-domain support with different site keys
#   - Assign profiles to forms for spam protection
#
# Per-form Configuration: /admin/forms
#   - Webhook delivery settings (URL, headers, retry policy)
#   - Email and captcha profile assignment
#   - Allowed origins (domain allowlisting)
#   - Rate limiting per form
#
# Rate Limiting: Configurable per form (default: 60 requests per minute per IP)
# Payload Limits: Max 200 fields, 2MB payload size (hardcoded)
#
# CLI discovery: miniform commands --json
# Full reference: docs/cli.md
